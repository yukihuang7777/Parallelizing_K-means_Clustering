#!/bin/bash
#PBS -N kmeans_weak
#PBS -P personal-hyou07
#PBS -j oe
#PBS -l walltime=02:00:00
#PBS -l select=8:ncpus=32:mpiprocs=32:ompthreads=1:mem=8gb

cd "$PBS_O_WORKDIR" || exit 1

module load mpich/ge/gcc/64/4.1.1 || exit 1
export FI_PROVIDER=tcp
export OMP_NUM_THREADS=1
mpicxx -O3 -std=c++17 mpi_kmeans.cpp -o mpi_kmeans_weak || exit 1

N_PER_RANK=50000
D=8
K=10
SEED=42
ITER=50
TOL=0

mkdir -p results

OUTPUT="results/weak_all_${PBS_JOBID}.csv"
echo "repeat,N,K,D,ranks,iterations,time_s,comm_max_s,wcss" > "$OUTPUT"

for P in 1 2 4 8 16 32 64 128 256
do
    N=$((N_PER_RANK * P))

    for repeat in 1 2 3 4 5
    do
        echo "Weak scaling: P=$P, N=$N, repeat=$repeat"

        mpirun -np "$P" ./mpi_kmeans_weak \
            "$N" "$D" "$K" "$SEED" "$ITER" "$TOL" \
            > weak_result.tmp || exit 1

        awk -v r="$repeat" '/^[0-9]+,[0-9]+,/ {print r "," $0}' \
            weak_result.tmp >> "$OUTPUT"
    done
done

rm -f weak_result.tmp
echo "Results saved in $OUTPUT"
