#!/bin/bash
#PBS -N km_32x2
#PBS -P personal-hyou07
#PBS -j oe
#PBS -l walltime=01:00:00
#PBS -l select=2:ncpus=32:mpiprocs=16:ompthreads=2:mem=8gb
#PBS -l place=scatter
# Default project: personal-hyou07. Override with qsub -P PROJECT if needed.
set -euo pipefail
cd "$PBS_O_WORKDIR"
module load mpich/ge/gcc/64/4.1.1
export FI_PROVIDER=tcp
export OMP_NUM_THREADS=2 OMP_DYNAMIC=FALSE OMP_PLACES=cores OMP_PROC_BIND=close
export RANKS_PER_NODE=16
mkdir -p results
{
    date -Is
    module list
    mpicxx -show
    sort "$PBS_NODEFILE" | uniq -c
    mpirun -np 32 -ppn 16 -bind-to core:2 -map-by core:2 sh -c 'hostname; taskset -pc $$'
} > "results/environment_${PBS_JOBID}.txt" 2>&1
# Compile once with build_cpu.sh before submitting these three jobs.
python3 ../benchmark.py hybrid --ranks 32 --threads 2 --output "results/hybrid_32x2_${PBS_JOBID}.csv"
