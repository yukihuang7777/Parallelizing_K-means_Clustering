#!/bin/bash
#PBS -N km_64x1
#PBS -P personal-hyou07
#PBS -j oe
#PBS -l walltime=01:00:00
#PBS -l select=2:ncpus=32:mpiprocs=32:ompthreads=1:mem=8gb
#PBS -l place=scatter
# Default project: personal-hyou07. Override with qsub -P PROJECT if needed.
set -euo pipefail
cd "$PBS_O_WORKDIR"
module load mpich/ge/gcc/64/4.1.1
export FI_PROVIDER=tcp
export OMP_NUM_THREADS=1 OMP_DYNAMIC=FALSE OMP_PLACES=cores OMP_PROC_BIND=close
export RANKS_PER_NODE=32
mkdir -p results
{
    date -Is
    module list
    mpicxx -show
    sort "$PBS_NODEFILE" | uniq -c
    mpirun -np 64 -ppn 32 -bind-to core:1 -map-by core:1 sh -c 'hostname; taskset -pc $$'
} > "results/environment_${PBS_JOBID}.txt" 2>&1
# Compile once with build_cpu.sh before submitting these three jobs.
python3 ../benchmark.py hybrid --ranks 64 --threads 1 --output "results/hybrid_64x1_${PBS_JOBID}.csv"
